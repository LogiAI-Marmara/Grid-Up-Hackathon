# Git ignore rules for Grid Up Hackathon

# Environment files and credentials (Madde 15)
.env
*.env
.env.*
!.env.example

# Node.js & Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Scratch, logs and temporary files
temp/
tmp/
*.tmp
*.log

# State persistence files
alarm_state.json
test_alarm_state.json
*.state.json

# Python virtual environments & build artifacts
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pyc
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor files
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json

# Claude & AI workspace files
.claude/
CLAUDE.md

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# KiCad yerel ayar dosyasi (kullanici/oturum)
*.kicad_prl

# KiCad GUI artıkları
docs/track-a/eda/.history/
*.lck

# PlatformIO
firmware/.pio/

# Markdown dokümanları
*.md
!deploy/README.md
