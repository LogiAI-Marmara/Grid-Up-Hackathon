# Git ignore rules for Grid Up Hackathon

# Environment files and credentials (Madde 15)
.env
*.env
.env.*
!.env.example

# Scratch / working files (not deliverables)
temp/

# State persistence files
alarm_state.json
test_alarm_state.json
*.state.json

# Python & build artifacts
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pyc

# Claude Code workspace files
.claude/
CLAUDE.md

# OS
Thumbs.db
.DS_Store

# KiCad yerel ayar dosyasi (kullanici/oturum)
*.kicad_prl

# KiCad GUI artıkları
docs/track-a/eda/.history/
*.lck
