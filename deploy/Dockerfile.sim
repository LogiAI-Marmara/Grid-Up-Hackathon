FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# requests kütüphanesi (sim_streamer.py için)
RUN pip install requests

# Modül simülatörü kaynak kodu (modul-sim alt dizini) + sözleşmeler
COPY repo/Grid-Up-Hackathon/modul-sim/ /app/modul-sim/
COPY repo/Grid-Up-Hackathon/sozlesmeler/ /app/sozlesmeler/

# Streamer script
COPY kodlar/deploy/sim_streamer.py /app/sim_streamer.py

# PYTHONPATH: sim_streamer.py'nin beklediği yol yapısı:
#   repo_kok/modul-sim  ve  repo_kok
# (sim_streamer.py bunları os.path.join ile kendisi kuruyor ama
#  env ile de belirtiyoruz ki container içinde de çalışsın)
ENV PYTHONPATH=/app/modul-sim:/app

CMD ["python", "/app/sim_streamer.py"]
