# Grid Up - On-Premise Docker Compose Örnek Ortam Değişkenleri (.env.example)
# Gerçek değerler için bu dosyayı .env olarak kopyalayıp doldurun.

# 1. Telegram Alarm Bildirimleri (Opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Sistem Zaman Dilimi
TZ=Europe/Istanbul

# 3. Alarm ve Anti-Flapping Ayarları
COOLDOWN_SECONDS=300
POLL_INTERVAL=5

# 4. Modbus TCP Ayarları
MODBUS_PORT=5020
MODBUS_HOST=0.0.0.0
