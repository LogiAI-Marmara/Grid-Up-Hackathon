# Grid Up - On-Premise Docker Compose Örnek Ortam Değişkenleri (.env.example)
# Gerçek değerler için bu dosyayı .env olarak kopyalayıp doldurun.

# 1. Acil bildirim kanalı — Android SMS Gateway (İZ C alarm servisi)
#
# Seçilen kanal: "SMS Gateway for Android" uygulamasının YEREL SUNUCU kipi.
# Telefonun kendi SIM'i üzerinden gönderir, LAN'da HTTP sunucusu açar.
#
# ⚠️ Uygulamanın BULUT kipini açmayın: mesajı sms-gate.app sunucuları
#    üzerinden geçirir ve karar kaydı §T6'nın public cloud yasağıyla çelişir.
#
# Kurulum: uygulamada "Local server" aç → gösterilen IP, kullanıcı adı ve
# parolayı buraya yaz. Telefon alarm sunucusuyla aynı ağda olmalı.
#
# ÖNEMLİ: burası boş bırakılırsa kritik alarmlar TESLİM EDİLEMEZ, bekleyen
# kuyruğunda birikir ve servis bunu açılışta uyarı olarak yazar.
SMS_GATEWAY_URL=http://192.168.1.50:8080/message
SMS_ALICILAR=+905551112233,+905559998877
SMS_GATEWAY_KULLANICI=
SMS_GATEWAY_PAROLA=
# Basic auth yerine JWT kullanılıyorsa:
SMS_GATEWAY_TOKEN=
# Cihazın belgelenmiş gövdesi; kurum içi düz bir gateway'e geçilirse
# örn. SMS_GATEWAY_MESAJ_ALANI=mesaj yapmak yeterli (kod değişmez).
SMS_GATEWAY_ALICI_ALANI=phoneNumbers
SMS_GATEWAY_MESAJ_ALANI=textMessage.text

# 2. Telegram Alarm Bildirimleri (Opsiyonel — BULUT)
# api.telegram.org kurum dışı bir bulut hizmetidir ve karar kaydı §T6'nın
# public cloud yasağıyla çelişir. Varsayılan kanal kuralında yer almaz;
# yalnız bilinçli bir ekip kararıyla açılmalıdır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Sistem Zaman Dilimi
TZ=Europe/Istanbul

# 4. Alarm ve Tekrar Önleme Ayarları
COOLDOWN_SECONDS=300
POLL_INTERVAL=5
# Seviye -> kanal kuralı. Sondaki '!' o kanalı ZORUNLU yapar: başarısız
# olursa olay teslim edilmiş sayılmaz ve yeniden denenir.
ALARM_KANAL_KURALI=uyari:konsol,sms|kritik:konsol,sms!
# Bozuk durum dosyasında davranış: dur | sifirla
ALARM_BOZUK_DURUM=dur

# 5. Modbus TCP Ayarları
MODBUS_PORT=5020
MODBUS_HOST=0.0.0.0
